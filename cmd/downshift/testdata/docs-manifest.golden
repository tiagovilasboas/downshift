  "mcp_tools": [
    "apply",
    "cancel",
    "collect",
    "delegate",
    "diff",
    "plan",
    "playbook",
    "providers",
    "release",
    "retrieve",
    "send",
    "status",
    "steer"
  ],
  "default_endpoints": {
    "9router": "http://localhost:20128"
  },
