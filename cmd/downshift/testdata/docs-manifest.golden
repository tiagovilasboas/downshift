{
  "version": "dev",
  "commands": [
    {
      "name": "--help",
      "summary": "Show the common commands",
      "alias_of": "help",
      "legacy": true
    },
    {
      "name": "--version",
      "summary": "Print the binary version",
      "alias_of": "version",
      "legacy": true
    },
    {
      "name": "-h",
      "summary": "Show the common commands",
      "alias_of": "help",
      "legacy": true
    },
    {
      "name": "accept",
      "summary": "Record developer acceptance for code delivered by subagents",
      "flags": [
        {
          "name": "--session"
        },
        {
          "name": "--used"
        },
        {
          "name": "--discarded"
        }
      ]
    },
    {
      "name": "antigravity",
      "summary": "Antigravity PreToolUse hook: rewrites a subagent's model"
    },
    {
      "name": "claude-code",
      "summary": "Claude Code PreToolUse hook: rewrites a subagent's model"
    },
    {
      "name": "claude-code-post-tool-use",
      "summary": "Claude Code post-spawn observation",
      "hidden": true,
      "legacy": true
    },
    {
      "name": "claude-code-session-start",
      "summary": "Claude Code session-start hook",
      "hidden": true,
      "legacy": true
    },
    {
      "name": "claude-code-subagent-stop",
      "summary": "Claude Code subagent-stop observation",
      "hidden": true,
      "legacy": true
    },
    {
      "name": "codex",
      "summary": "Codex PreToolUse hook: rewrites a subagent's model"
    },
    {
      "name": "codex-post-tool-use",
      "summary": "Codex post-spawn observation",
      "hidden": true
    },
    {
      "name": "codex-session-start",
      "summary": "Codex session-start hook",
      "hidden": true
    },
    {
      "name": "compact",
      "summary": "Cut a test, build or status command's output to its PASS/FAIL summary",
      "flags": [
        {
          "name": "--session"
        },
        {
          "name": "--harness"
        },
        {
          "name": "--allowlisted"
        },
        {
          "name": "--discard-stderr"
        },
        {
          "name": "--exit-zero"
        }
      ]
    },
    {
      "name": "compactor",
      "summary": "Product name of compact",
      "alias_of": "compact",
      "legacy": true
    },
    {
      "name": "config",
      "summary": "Every effective setting with its value and source",
      "flags": [
        {
          "name": "--json"
        }
      ]
    },
    {
      "name": "context",
      "summary": "Context optimisation status, providers and compression (experimental)",
      "experimental": true
    },
    {
      "name": "context compress",
      "summary": "Compress tool output read from stdin (experimental)",
      "experimental": true,
      "flags": [
        {
          "name": "--exit"
        },
        {
          "name": "--observe"
        },
        {
          "name": "--safe"
        },
        {
          "name": "--off"
        }
      ]
    },
    {
      "name": "context enable",
      "summary": "Enable the native compactor, or record a companion provider",
      "experimental": true,
      "flags": [
        {
          "name": "--exec"
        },
        {
          "name": "--no-exec"
        }
      ]
    },
    {
      "name": "cursor",
      "summary": "Cursor preToolUse hook: rewrites a subagent's model"
    },
    {
      "name": "cursor-touch",
      "summary": "Cursor session hooks: remembers the composer model",
      "hidden": true
    },
    {
      "name": "dci",
      "summary": "Removed: code intelligence is gone"
    },
    {
      "name": "discover",
      "summary": "Find commands the compactor would have changed but that ran bare",
      "flags": [
        {
          "name": "--since"
        },
        {
          "name": "--harness"
        },
        {
          "name": "--top"
        },
        {
          "name": "--json"
        }
      ]
    },
    {
      "name": "docs-manifest",
      "summary": "Print the documentation manifest as JSON",
      "hidden": true
    },
    {
      "name": "doctor",
      "summary": "Checklist: binary, hooks per harness, state, with a fix per failure",
      "flags": [
        {
          "name": "--verbose"
        },
        {
          "name": "--json"
        },
        {
          "name": "--quiet"
        },
        {
          "name": "--check-latest"
        },
        {
          "name": "--harness"
        },
        {
          "name": "--self-test"
        }
      ]
    },
    {
      "name": "enable",
      "summary": "Print shell aliases for transparent compaction"
    },
    {
      "name": "end",
      "summary": "Child-end observation: marks a subagent as finished"
    },
    {
      "name": "eval-outcome",
      "summary": "Outcome eval: executable checks, small vs frontier pass rate",
      "experimental": true,
      "flags": [
        {
          "name": "--verify"
        },
        {
          "name": "--record"
        },
        {
          "name": "--tier"
        },
        {
          "name": "--model"
        },
        {
          "name": "--solver"
        },
        {
          "name": "--report"
        },
        {
          "name": "--write"
        },
        {
          "name": "--check"
        },
        {
          "name": "--tasks"
        },
        {
          "name": "--runs"
        }
      ]
    },
    {
      "name": "exec",
      "summary": "Old name of compact",
      "alias_of": "compact",
      "legacy": true
    },
    {
      "name": "export",
      "summary": "Counts and token totals an outside operator can share",
      "flags": [
        {
          "name": "--days"
        }
      ]
    },
    {
      "name": "gateway",
      "summary": "Check local companion routers (9router)",
      "flags": [
        {
          "name": "--json"
        },
        {
          "name": "--endpoint"
        }
      ]
    },
    {
      "name": "help",
      "summary": "Show the common commands, or every command with --all",
      "flags": [
        {
          "name": "--all",
          "short": "-a"
        }
      ]
    },
    {
      "name": "honor",
      "summary": "Post-spawn observation: records whether the routing was honored"
    },
    {
      "name": "kiro",
      "summary": "Kiro IDE PreToolUse hook: rewrites a subagent's model"
    },
    {
      "name": "kiro-post-tool-use",
      "summary": "Kiro IDE post-spawn observation",
      "hidden": true
    },
    {
      "name": "kiro-session-start",
      "summary": "Kiro IDE session-start hook",
      "hidden": true
    },
    {
      "name": "kirocrew",
      "summary": "KiroCrew preToolUse hook: policy mode, exit 0 allow or 2 block"
    },
    {
      "name": "learning",
      "summary": "Compressor learning status",
      "experimental": true
    },
    {
      "name": "loop",
      "summary": "Run an engineering loop with sensor verification and cascade auto-upgrade",
      "experimental": true,
      "flags": [
        {
          "name": "--task"
        },
        {
          "name": "--sensor"
        },
        {
          "name": "--iterations"
        },
        {
          "name": "--timeout"
        },
        {
          "name": "--session"
        },
        {
          "name": "--model"
        },
        {
          "name": "--batch"
        },
        {
          "name": "--continue-on-error"
        },
        {
          "name": "--json"
        }
      ]
    },
    {
      "name": "mcp",
      "summary": "Run the MCP server the orchestrator can ask"
    },
    {
      "name": "models",
      "summary": "The effective catalog and what each harness can use"
    },
    {
      "name": "models available",
      "summary": "The models a spawn can use now on a harness",
      "flags": [
        {
          "name": "--harness"
        },
        {
          "name": "--json"
        }
      ]
    },
    {
      "name": "models check",
      "summary": "Query provider APIs and report new or untiered models"
    },
    {
      "name": "models discover",
      "summary": "Ask each harness which models the account can use",
      "flags": [
        {
          "name": "--harness"
        },
        {
          "name": "--dry-run"
        },
        {
          "name": "--json"
        }
      ]
    },
    {
      "name": "models list",
      "summary": "Show the effective catalog (embedded or override)"
    },
    {
      "name": "models pull",
      "summary": "Write the user catalog.json under the state dir"
    },
    {
      "name": "opencode",
      "summary": "OpenCode subagent_spawn_intent route hook (wire v1)"
    },
    {
      "name": "plan",
      "summary": "Validate a delegation plan and print it as a table",
      "flags": [
        {
          "name": "--json"
        }
      ]
    },
    {
      "name": "playbook",
      "summary": "Edit the working rules a delegated worker receives"
    },
    {
      "name": "policy",
      "summary": "Validate the routing policy without routing anything",
      "flags": [
        {
          "name": "--dry-run"
        },
        {
          "name": "--yes",
          "short": "-y"
        },
        {
          "name": "--harness"
        },
        {
          "name": "--bare"
        }
      ]
    },
    {
      "name": "probe",
      "summary": "Record a payload's field names (never prompts or paths) in probe.jsonl",
      "experimental": true
    },
    {
      "name": "quota",
      "summary": "Inspect, import or collect budget evidence for a harness",
      "flags": [
        {
          "name": "--harness"
        },
        {
          "name": "--source"
        },
        {
          "name": "--ttl"
        },
        {
          "name": "--transcript"
        },
        {
          "name": "--model"
        }
      ]
    },
    {
      "name": "report",
      "summary": "Measured: routed spawns, tokens per completed task, rework per verdict",
      "flags": [
        {
          "name": "--days"
        },
        {
          "name": "--json"
        },
        {
          "name": "--text"
        },
        {
          "name": "--markdown"
        },
        {
          "name": "--daily"
        },
        {
          "name": "--history"
        },
        {
          "name": "--by"
        }
      ]
    },
    {
      "name": "report clear",
      "summary": "Move every measurement log to a backup so the measurement starts from zero",
      "flags": [
        {
          "name": "--dry-run"
        },
        {
          "name": "--yes",
          "short": "-y"
        }
      ]
    },
    {
      "name": "retrieve",
      "summary": "Print the full output the compactor kept for an id",
      "flags": [
        {
          "name": "--grep"
        },
        {
          "name": "--head"
        },
        {
          "name": "--tail"
        },
        {
          "name": "--lines"
        }
      ]
    },
    {
      "name": "route",
      "summary": "Show what would be applied for one spawn",
      "flags": [
        {
          "name": "--harness"
        },
        {
          "name": "--model"
        },
        {
          "name": "--effort"
        },
        {
          "name": "--tier"
        },
        {
          "name": "--agent-type"
        },
        {
          "name": "--dir"
        },
        {
          "name": "--json"
        }
      ]
    },
    {
      "name": "session",
      "summary": "This session's subagents as a tree (every harness)",
      "flags": [
        {
          "name": "--tree"
        },
        {
          "name": "--why"
        },
        {
          "name": "--pause"
        },
        {
          "name": "--resume"
        },
        {
          "name": "--session"
        },
        {
          "name": "--json"
        },
        {
          "name": "--panel"
        },
        {
          "name": "--no-report"
        },
        {
          "name": "--brief"
        }
      ]
    },
    {
      "name": "setup",
      "summary": "Wire the hooks into every harness found (backup, diff, --undo)",
      "flags": [
        {
          "name": "--tui"
        },
        {
          "name": "--no-tui"
        },
        {
          "name": "--dry-run"
        },
        {
          "name": "--undo"
        },
        {
          "name": "--yes",
          "short": "-y"
        },
        {
          "name": "--no-session-policy"
        },
        {
          "name": "--you-should-know"
        },
        {
          "name": "--no-plugin"
        },
        {
          "name": "--no-mods"
        },
        {
          "name": "--no-mcp"
        },
        {
          "name": "--no-skills"
        },
        {
          "name": "--no-steering"
        },
        {
          "name": "--no-policy"
        },
        {
          "name": "--keep-binaries"
        },
        {
          "name": "--workers"
        },
        {
          "name": "--allow-unsafe-binary"
        },
        {
          "name": "--mcp",
          "deprecated": true
        }
      ]
    },
    {
      "name": "shell-init",
      "summary": "Deprecated alias of enable",
      "alias_of": "enable",
      "legacy": true
    },
    {
      "name": "stats",
      "summary": "Decisions and the tiers spawns ran on",
      "flags": [
        {
          "name": "--days"
        },
        {
          "name": "--by-harness"
        },
        {
          "name": "--detail"
        },
        {
          "name": "--export"
        }
      ]
    },
    {
      "name": "uninstall",
      "summary": "Restore harness hook configurations and remove wrappers",
      "flags": [
        {
          "name": "--dry-run"
        },
        {
          "name": "--yes",
          "short": "-y"
        },
        {
          "name": "--purge"
        }
      ]
    },
    {
      "name": "update",
      "summary": "Install the latest release, then refresh every harness (asks first)",
      "flags": [
        {
          "name": "--check"
        },
        {
          "name": "--yes",
          "short": "-y"
        },
        {
          "name": "--version"
        }
      ]
    },
    {
      "name": "usage",
      "summary": "Post-spawn usage observation: records tokens"
    },
    {
      "name": "version",
      "summary": "Print the binary version"
    },
    {
      "name": "watch",
      "summary": "Live session tree, redrawn every interval",
      "flags": [
        {
          "name": "--session"
        },
        {
          "name": "--interval"
        },
        {
          "name": "--once"
        }
      ]
    }
  ],
  "env_vars": [
    "DOWNSHIFT_BALANCED",
    "DOWNSHIFT_BUDGET_TOKENS",
    "DOWNSHIFT_CCR",
    "DOWNSHIFT_CCR_FAILURES",
    "DOWNSHIFT_CURSOR_NATIVE_FILE",
    "DOWNSHIFT_DESKTOP_DELTA",
    "DOWNSHIFT_DISCOVERED",
    "DOWNSHIFT_DISCOVERY",
    "DOWNSHIFT_DISCOVERY_OPENROUTER",
    "DOWNSHIFT_DISCOVERY_TTL",
    "DOWNSHIFT_DOMAIN_DEDUP",
    "DOWNSHIFT_DOMAIN_INTERACTIONS",
    "DOWNSHIFT_DOMAIN_SIGNALS",
    "DOWNSHIFT_EVENT_LOG",
    "DOWNSHIFT_EXEC",
    "DOWNSHIFT_EXEC_DEPTH",
    "DOWNSHIFT_HOOK_TEST_P",
    "DOWNSHIFT_KIROCREW_DIR",
    "DOWNSHIFT_LEARNING",
    "DOWNSHIFT_LOG_MAX_BACKUPS",
    "DOWNSHIFT_LOG_MAX_MB",
    "DOWNSHIFT_MANAGED",
    "DOWNSHIFT_MAX_PARALLEL",
    "DOWNSHIFT_MINILM",
    "DOWNSHIFT_PLAIN",
    "DOWNSHIFT_POST_COMPACT",
    "DOWNSHIFT_QUIET",
    "DOWNSHIFT_QUOTA_FILE",
    "DOWNSHIFT_QUOTA_MODE",
    "DOWNSHIFT_QUOTA_STOP_PCT",
    "DOWNSHIFT_SEMANTIC_BOOST",
    "DOWNSHIFT_SESSION_MODELS",
    "DOWNSHIFT_STATE_DIR",
    "DOWNSHIFT_TEST_TIMEOUT_SCALE",
    "DOWNSHIFT_TEST_TIMING",
    "DOWNSHIFT_WORKER",
    "DOWNSHIFT_WORKERS",
    "DOWNSHIFT_WORKER_ENV",
    "DOWNSHIFT_WORKER_TOKEN_BUDGET"
