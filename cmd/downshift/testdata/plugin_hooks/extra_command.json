{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "downshift claude-code" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "downshift claude-code" }]
      },
      {
        "matcher": "Edit",
        "hooks": [{ "type": "command", "command": "downshift claude-code" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "downshift claude-code-post-tool-use" }]
      },
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "downshift claude-code-post-tool-use" },
          { "type": "command", "command": "other-tool audit" }
        ]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [{ "type": "command", "command": "downshift claude-code-post-tool-use" }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "downshift claude-code-post-tool-use" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "downshift claude-code-session-start" }]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [{ "type": "command", "command": "downshift claude-code-subagent-stop" }]
      }
    ]
  }
}
