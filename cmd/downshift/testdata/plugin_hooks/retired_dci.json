{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [{ "type": "command", "command": "downshift dci hook claude-code" }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "downshift claude-code" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "downshift claude-code" }]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "downshift claude-code-post-tool-use" }]
      },
      {
        "matcher": "Bash",
        "hooks": [{ "type": "command", "command": "downshift claude-code-post-tool-use" }]
      },
      {
        "matcher": "Read|Grep|Glob",
        "hooks": [{ "type": "command", "command": "downshift claude-code-post-tool-use" }]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Agent|Task",
        "hooks": [{ "type": "command", "command": "downshift claude-code-post-tool-use" }]
      }
    ],
    "SessionStart": [
      {
        "hooks": [{ "type": "command", "command": "downshift claude-code-session-start" }]
      }
    ]
  }
}
