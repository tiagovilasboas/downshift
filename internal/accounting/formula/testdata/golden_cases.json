{
  "description": "Golden test fixtures for Saved formula regression testing",
  "version": "1.0.0",
  "cases": [
    {
      "name": "empty_buckets",
      "description": "Empty bucket list returns zero saving",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [],
      "expected": {
        "quality": "exact",
        "saved": 0,
        "total_tokens": 0,
        "valid": true
      }
    },
    {
      "name": "same_model_zero_saving",
      "description": "All buckets on requested model = zero saving",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "claude-sonnet-5-5", "input": 1000000, "output": 500000}
      ],
      "expected": {
        "quality": "exact",
        "saved_approx": 0,
        "total_tokens": 1500000,
        "valid": true
      }
    },
    {
      "name": "cheaper_model_positive_saving",
      "description": "Haiku instead of Sonnet = positive saving",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "claude-haiku-4-5", "input": 1000000, "output": 500000}
      ],
      "expected": {
        "quality": "exact",
        "saved_positive": true,
        "total_tokens": 1500000,
        "valid": true
      }
    },
    {
      "name": "expensive_model_negative_saving",
      "description": "Opus instead of Sonnet = negative saving (upshift)",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "claude-opus-5-5", "input": 1000000, "output": 500000}
      ],
      "expected": {
        "quality": "exact",
        "saved_positive": false,
        "total_tokens": 1500000,
        "valid": true
      }
    },
    {
      "name": "mixed_models_net_saving",
      "description": "Half on Haiku, half on Sonnet = net positive saving",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "claude-haiku-4-5", "input": 500000, "output": 250000},
        {"model": "claude-sonnet-5-5", "input": 500000, "output": 250000}
      ],
      "expected": {
        "quality": "exact",
        "saved_positive": true,
        "total_tokens": 1500000,
        "valid": true
      }
    },
    {
      "name": "inferred_slug_haiku",
      "description": "Uppercase HAIKU slug inferred to claude-haiku-5-5",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "HAIKU", "input": 1000000, "output": 500000}
      ],
      "expected": {
        "quality": "mixed",
        "saved_positive": true,
        "inferred_buckets": 1,
        "valid": true
      }
    },
    {
      "name": "unpriced_bucket_partial",
      "description": "One unknown model bucket = partial quality; excluded from costs (priced: baseline 3.50, actual 1.75)",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "unknown-xyz", "input": 500000, "output": 250000},
        {"model": "claude-haiku-4-5", "input": 500000, "output": 250000}
      ],
      "expected": {
        "quality": "partial",
        "saved_approx": 1.75,
        "unpriced_buckets": 1,
        "unpriced_tokens": 750000,
        "total_tokens": 1500000,
        "valid": true
      }
    },
    {
      "name": "mixed_priced_unpriced_excludes_unpriced_from_costs",
      "description": "Unknown bucket is larger than the priced one and must not enter C_actual or C_baseline. Priced: 0.5M in / 0.25M out; baseline sonnet 3.50, actual haiku 1.75, saved 1.75 (50%)",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "unknown-xyz", "input": 1000000, "output": 500000},
        {"model": "claude-haiku-4-5", "input": 500000, "output": 250000}
      ],
      "expected": {
        "quality": "partial",
        "saved_approx": 1.75,
        "saved_positive": true,
        "unpriced_buckets": 1,
        "unpriced_tokens": 1500000,
        "total_tokens": 2250000,
        "saved_percent_applicable": true,
        "valid": true
      }
    },
    {
      "name": "all_buckets_unpriced_saved_percent_na",
      "description": "Priced baseline but every bucket unpriced: no priced tokens, costs are zero, SavedPercent is n/a",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "unknown-a", "input": 500000, "output": 250000},
        {"model": "unknown-b", "input": 500000, "output": 250000}
      ],
      "expected": {
        "quality": "partial",
        "unpriced_buckets": 2,
        "unpriced_tokens": 1500000,
        "total_tokens": 1500000,
        "saved_percent_applicable": false,
        "valid": true
      }
    },
    {
      "name": "unpriced_baseline",
      "description": "Unknown requested model = unpriced quality",
      "requested_model": "unknown-baseline",
      "buckets": [
        {"model": "claude-haiku-4-5", "input": 1000000, "output": 500000}
      ],
      "expected": {
        "quality": "unpriced",
        "valid": false
      }
    },
    {
      "name": "cache_tokens_included",
      "description": "Cache read/write tokens counted in total and priced",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {
          "model": "claude-haiku-4-5",
          "input": 100000,
          "output": 50000,
          "cache_read": 200000,
          "cache_write": 100000
        }
      ],
      "expected": {
        "quality": "exact",
        "total_tokens": 450000,
        "saved_positive": true,
        "valid": true
      }
    },
    {
      "name": "multiple_buckets_same_cheaper_model",
      "description": "Multiple buckets all on same cheaper model",
      "requested_model": "claude-sonnet-5-5",
      "buckets": [
        {"model": "claude-haiku-4-5", "input": 100000, "output": 50000},
        {"model": "claude-haiku-4-5", "input": 200000, "output": 100000},
        {"model": "claude-haiku-4-5", "input": 300000, "output": 150000}
      ],
      "expected": {
        "quality": "exact",
        "total_tokens": 900000,
        "saved_positive": true,
        "valid": true
      }
    },
    {
      "name": "haiku_baseline_same_model",
      "description": "Haiku baseline with Haiku buckets = zero saving",
      "requested_model": "claude-haiku-4-5",
      "buckets": [
        {"model": "claude-haiku-4-5", "input": 1000000, "output": 500000}
      ],
      "expected": {
        "quality": "exact",
        "saved_approx": 0,
        "total_tokens": 1500000,
        "valid": true
      }
    },
    {
      "name": "opus_baseline_downshift_to_haiku",
      "description": "Opus baseline with Haiku execution = large saving",
      "requested_model": "claude-opus-5-5",
      "buckets": [
        {"model": "claude-haiku-4-5", "input": 1000000, "output": 500000}
      ],
      "expected": {
        "quality": "exact",
        "saved_positive": true,
        "total_tokens": 1500000,
        "valid": true
      }
    }
  ]
}
