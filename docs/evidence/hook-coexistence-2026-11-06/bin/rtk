#!/usr/bin/env bash
# FIXTURE STAND-IN for the rtk binary. The real RTK was not installed or run.
# It implements only what the published rtk-rewrite.sh (v4) calls: `--version` and
# `rewrite`, plus a runner so `rtk go test ...` executes the command and keeps its
# exit code. It says nothing about the real RTK's rewrite rules or exit handling.
case "$1" in
  --version) echo "rtk 0.37.2"; exit 0;;
  rewrite)
    shift; cmd="$*"
    case "$cmd" in
      rtk\ *) echo "$cmd"; exit 0;;
      go\ *|git\ *|cargo\ *) echo "rtk $cmd"; exit 0;;
      *) exit 1;;
    esac;;
  *) echo "rtk-ran argv: $*" >> "$FIXTURE_LOG"; "$@"; exit $?;;
esac
